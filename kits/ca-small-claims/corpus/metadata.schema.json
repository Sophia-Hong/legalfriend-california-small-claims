{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legalfriend.ai/schemas/ca-small-claims/chunk-metadata.v1.json",
  "title": "LegalFriend corpus chunk",
  "description": "One retrievable chunk in corpus/chunks.jsonl. Metadata per PRD §10.2; `layer` enforces the three-layer provenance rule (PRD §5.4).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunk_id", "source_id", "layer", "text",
    "jurisdiction", "court_level", "county", "proceeding", "side", "stage",
    "document_type", "form_number", "effective_date",
    "source_url", "source_title", "publisher", "official",
    "last_verified", "version_hash", "supersedes", "superseded_by"
  ],
  "properties": {
    "chunk_id": { "type": "string" },
    "source_id": { "type": "string", "description": "Matches an id in sources/manifest.yaml, or a practice-note file id." },
    "layer": { "enum": ["official_source", "practice_note"], "description": "AI WORKSPACE output is never stored in the corpus." },
    "text": { "type": "string", "minLength": 1 },
    "heading_path": { "type": "array", "items": { "type": "string" } },

    "jurisdiction": { "const": "CA" },
    "court_level": { "enum": ["statewide", "superior_court"] },
    "county": { "type": ["string", "null"], "pattern": "^[a-z_]+$" },
    "proceeding": { "const": "small_claims" },
    "side": { "enum": ["plaintiff", "defendant", "both"] },
    "stage": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["prefiling", "pleading", "filing", "service", "hearing", "judgment"] }
    },
    "document_type": {
      "enum": ["self_help", "form", "instruction", "statute", "case", "rule", "local_rule", "practice_note"]
    },
    "form_number": { "type": ["string", "null"], "pattern": "^[A-Z]{2,3}-[0-9]{2,4}[A-Z]?(-INFO)?$" },
    "effective_date": { "type": ["string", "null"], "format": "date" },

    "source_url": { "type": "string", "format": "uri" },
    "source_title": { "type": "string" },
    "publisher": { "type": "string" },
    "official": { "type": "boolean" },
    "last_verified": { "type": "string", "format": "date" },
    "version_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "layer": { "const": "practice_note" } } },
      "then": { "properties": { "official": { "const": false }, "document_type": { "const": "practice_note" } } }
    },
    {
      "if": { "properties": { "layer": { "const": "official_source" } } },
      "then": { "properties": { "official": { "const": true }, "document_type": { "not": { "const": "practice_note" } } } }
    }
  ]
}
