---
// Copy: PRD §1, §5.3–5.4, §9.1, §14 (docs/PRD.md); notice mirrors DISCLAIMER.md.
// Stay within PRD §6.4 marketing guardrails.
import Base from "../../layouts/Base.astro"
import RelationshipNotice from "../../components/RelationshipNotice.astro"
import { KIT_CHECKOUT_URL, KIT_PRICE_LABEL, WAITLIST_OPEN } from "../../site"

const stages = [
  ["Before filing", "Small claims fit, the right defendant, venue, and pre-filing checklists."],
  ["Build your claim", "Describe the dispute and build a dated timeline of what happened."],
  ["Prepare forms", "The current SC-100, field by field, with SC-100A / SC-103 triggers and a local-form check."],
  ["Serve defendant", "Filing and service overview, proof-of-service resources, and deadline issue-spotting."],
  ["Hearing prep", "Evidence inventory, exhibit checklist, and questions you should be ready to answer."],
  ["After judgment", "Judgment orientation and official collection resources."],
]
const layers = [
  ["Official source", "California Courts, Judicial Council forms and instructions, statutes, rules, Superior Court resources."],
  ["LegalFriend practice note", "General educational commentary, common pitfalls, and issue-spotting from a California attorney."],
  ["AI workspace", "Summaries, checklists, drafts, and organization produced by the AI you choose."],
]
const steps = [
  "Purchase and download the kit",
  "Choose your preferred AI",
  "Work through your case",
  "Verify against the official source",
]
const never = [
  "No case intake",
  "No upload of your case files to LegalFriend",
  "No access to your AI prompts",
  "No access to your AI's answers",
]
---
<Base
  title="California Small Claims Help 2026 | AI Self-Help Kit | LegalFriend"
  description="Navigate California small claims court with a lawyer-designed AI self-help kit built around official California court materials. Understand SC-100, venue, service, evidence, hearing preparation, and judgment collection."
>
    <header class="hero">
      <div class="wrap">
        <div class="hero-card">
          <div>
            <span class="eyebrow">California Small Claims · Plaintiff</span>
            <h1>California Small Claims, Made Understandable</h1>
            <p class="sub">Handle your California small claims case with a lawyer-designed AI self-help kit.</p>
            <p class="tag">California gives you the forms.<br />LegalFriend helps you understand how the pieces fit together.</p>
            {KIT_CHECKOUT_URL ? (
              <>
                <a class="btn btn--primary" href={KIT_CHECKOUT_URL}>Get the California Small Claims Kit <span class="arrow" aria-hidden="true">→</span></a>
                <span class="cta-note">{KIT_PRICE_LABEL} one-time purchase · Full refund until you download · <a href="/terms">Terms</a></span>
              </>
            ) : WAITLIST_OPEN ? (
              <form class="waitlist" id="waitlist" method="post" action="/api/waitlist" data-waitlist>
                <p class="wl-lead">The kit isn't ready yet. Leave your email and we'll let you know once when it is.</p>
                <input type="hidden" name="kit" value="ca-small-claims" />
                <div class="wl-row">
                  <label class="wl-sr" for="wl-email">Email</label>
                  <input id="wl-email" type="email" name="email" required maxlength="254" autocomplete="email" placeholder="you@example.com" />
                  <button class="btn btn--primary" type="submit">Notify me</button>
                </div>
                <input class="wl-hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
                <p class="wl-done" role="status" hidden>Thanks. We'll email you once when the kit is ready.</p>
                <p class="wl-err" role="alert" hidden>Something went wrong. Please try again.</p>
                <p class="wl-bad" role="alert" hidden>That doesn't look like an email address.</p>
                <p class="cta-note wl-privacy">We'll use your email only to tell you once when the California Small Claims Kit is available. Please don't include anything about your case. See our <a href="/privacy">Privacy Policy</a>.</p>
              </form>
            ) : (
              <>
                <a class="btn btn--primary" aria-disabled="true" role="link">Get the California Small Claims Kit <span class="arrow" aria-hidden="true">→</span></a>
                <span class="cta-note">Not yet available.</span>
              </>
            )}
          </div>

          <figure class="deck" aria-label="How the kit keeps sources separate">
            <div class="deck-head">
              <span class="eyebrow eyebrow--dark">Three-layer provenance</span>
            </div>
            <ol class="layers">
              {layers.map(([label, text]) => (
                <li class="layer"><span class="label">[{label}]</span><p>{text}</p></li>
              ))}
            </ol>
            <figcaption class="deck-foot">Built around official California court materials, organized so you and your own AI can actually use them.</figcaption>
          </figure>
        </div>
      </div>
    </header>

    <section class="section section--paper" id="inside">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">What's inside</span>
          <h2>More Than an SC-100 Form Filler</h2>
          <p>Don't just fill out a form. Understand your small claims case.</p>
        </div>
        <ol class="grid3">
          {stages.map(([name, text], i) => (
            <li class="card">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{name}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section" id="your-ai">
      <div class="wrap">
        <div class="band">
          <div>
            <span class="eyebrow eyebrow--dark">Bring your own AI</span>
            <h2>Built for Your AI. Not Ours.</h2>
            <ol class="steps">
              {steps.map((s) => <li>{s}</li>)}
            </ol>
          </div>
          <ul class="never" aria-label="What LegalFriend does not receive">
            {never.map((n) => <li>{n}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="section section--notice" id="notice">
      <div class="wrap">
        <div class="purchase-panel">
          <div class="purchase-panel__intro">
            <span class="eyebrow eyebrow--dark">Before you buy</span>
            <h2>Your case stays with you and your AI.</h2>
            <p>The AI you choose handles your case materials. LegalFriend does not access your case information, records, documents, prompts, or AI answers.</p>
            <p class="purchase-panel__links">Full details are in our <a href="/terms">Terms of Sale and Use</a> and <a href="/privacy">Privacy Policy</a>.</p>
          </div>
          <RelationshipNotice />
        </div>
      </div>
    </section>
</Base>

<style>
  .waitlist { display: grid; gap: 10px; max-width: 460px; }
  .wl-lead { margin: 0; }
  .wl-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .wl-row input[type="email"] { flex: 1 1 220px; min-width: 0; padding: 12px 14px; font: inherit; font-size: 16px; border: 1px solid var(--cloud); border-radius: var(--radius); }
  .wl-sr, .wl-hp { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .wl-done, .wl-err { margin: 0; font-weight: 600; }
  .wl-err, .wl-bad { color: #b42318; }
  .wl-privacy { margin: 0; }
</style>

<script>
  // Fetch submit (no reload); without JS the form posts and the function redirects back with ?waitlist=ok|error.
  const form = document.querySelector<HTMLFormElement>("form[data-waitlist]")
  if (form) {
    const done = form.querySelector<HTMLElement>(".wl-done")!
    const err = form.querySelector<HTMLElement>(".wl-err")!
    const bad = form.querySelector<HTMLElement>(".wl-bad")!
    const row = form.querySelector<HTMLElement>(".wl-row")!
    // ok | "bad_email" (server refused the address: Shirl 1792396185) | anything else = generic retry line
    const show = (ok: boolean, reason = "") => { done.hidden = !ok; bad.hidden = ok || reason !== "bad_email"; err.hidden = ok || reason === "bad_email"; if (ok) row.hidden = true }
    const q = new URLSearchParams(location.search).get("waitlist")
    if (q) show(q === "ok")
    form.addEventListener("submit", async (e) => {
      e.preventDefault()
      const data = Object.fromEntries(new FormData(form) as any)
      try {
        const r = await fetch("/api/waitlist", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) })
        const j = await r.json().catch(() => ({}))
        show(r.ok, j.reason || "")
      } catch {
        show(false)
      }
    })
  }
</script>
