---
import Base from "../layouts/Base.astro"
// Lease card copy: DRAFT 2026-10-01, pending attorney review (with /california-lease-review).
---
<Base
  title="LegalFriend | Lawyer-designed self-help for the AI you choose"
  description="Lawyer-designed self-help toolkits built around official California court materials, for use with the AI you choose."
>
  <section class="home-hero">
    <div class="wrap">
      <span class="eyebrow">Built for your AI. Not ours.</span>
      <h1>Lawyer-designed self-help toolkits for the AI you choose.</h1>
      <p>Built around official California court materials.</p>

      <div class="products">
        <a class="product product--dark" href="/california-small-claims">
          <div>
            <span class="eyebrow eyebrow--dark">California · Small claims</span>
            <h2>California Small Claims Kit</h2>
            <p>California gives you the forms. LegalFriend helps you understand how the pieces fit together.</p>
          </div>
          <span class="go">See the kit <span aria-hidden="true">→</span></span>
        </a>
        <a class="product product--light" href="/california-lease-review">
          <div>
            <span class="eyebrow">California · Renters</span>
            <h2>California Lease Review Kit</h2>
            <p>Read your lease section by section with the AI you choose. LegalFriend never sees your lease.</p>
          </div>
          <span class="go">See the kit <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>
</Base>
