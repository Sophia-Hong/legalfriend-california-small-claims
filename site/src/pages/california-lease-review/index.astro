---
// DRAFT landing copy (2026-10-01) for the California Lease Review Kit — pending attorney
// review; noindex and out of the sitemap until LEASE_LANDING_APPROVED. Section names follow
// the retired Lease Review service (Money, Rules, Repairs, Privacy, Ending, Deposit).
import Base from "../../layouts/Base.astro"
import RelationshipNotice from "../../components/RelationshipNotice.astro"
import { LEASE_KIT_CHECKOUT_URL, LEASE_KIT_PRICE_LABEL, LEASE_LANDING_APPROVED, LEASE_ACCESS_UNTIL } from "../../site"

const sections = [
  ["Money", "Rent, every deposit and fee, and late fees, with the arithmetic laid out so you can check it."],
  ["Rules", "Pets, guests, subletting, and the clauses California law treats differently than they read."],
  ["Repairs", "Who maintains what, and the habitability standards a lease can't waive."],
  ["Privacy", "When and how the landlord can enter, and what the notice rules say."],
  ["Ending", "Renewal, notice periods, rent increases, and leaving early."],
  ["Deposit", "Move-in records, allowed deductions, and the 21-day return timeline."],
]
const steps = [
  "Purchase and download the kit",
  "Load it into the AI you choose",
  "Share your lease with your own AI",
  "Check each flagged item against the official source",
]
const never = [
  "No lease upload to LegalFriend",
  "No access to your AI prompts",
  "No access to your AI's answers",
  "No accounts, no stored documents",
]
---
<Base
  title="California Lease Review Kit | Read Your Lease With Your Own AI | LegalFriend"
  description="A lawyer-designed self-help kit that helps the AI you choose read a California residential lease section by section (deposits, fees, repairs, entry, renewal, and deposit return), with official sources for every rule."
  noindex={!LEASE_LANDING_APPROVED}
>
  <header class="hero">
    <div class="wrap">
      <div class="hero-card">
        <div>
          <span class="eyebrow">California · Renters</span>
          <h1>Understand Your California Lease</h1>
          <p class="sub">A lawyer-designed self-help kit that helps the AI you choose read your lease section by section and point out clauses worth a closer look under California law.</p>
          <p class="tag">Your lease goes only to the AI you choose.<br />LegalFriend never sees it.</p>
          {LEASE_KIT_CHECKOUT_URL ? (
            <>
              <a class="btn btn--primary" href={LEASE_KIT_CHECKOUT_URL}>Get the Lease Review Kit <span class="arrow" aria-hidden="true">→</span></a>
              <span class="cta-note">{LEASE_KIT_PRICE_LABEL} one-time purchase · Full refund until you download · <a href="/terms">Terms</a></span>
            </>
          ) : (
            <>
              <a class="btn btn--primary" aria-disabled="true" role="link">Get the Lease Review Kit <span class="arrow" aria-hidden="true">→</span></a>
              <span class="cta-note">Coming soon.</span>
            </>
          )}
        </div>
        <figure class="deck" aria-label="Sections the kit covers">
          <div class="deck-head"><span class="eyebrow eyebrow--dark">Six sections, one lease</span></div>
          <ol class="layers">
            {sections.slice(0, 3).map(([label, text]) => (
              <li class="layer"><span class="label">[{label}]</span><p>{text}</p></li>
            ))}
          </ol>
          <figcaption class="deck-foot">Every rule your AI cites comes with its California source, so you can check it yourself.</figcaption>
        </figure>
      </div>
    </div>
  </header>

  <section class="section section--paper" id="inside">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What's inside</span>
        <h2>Read Every Section With Context</h2>
        <p>Know what you're signing, and what California law says about it.</p>
      </div>
      <ol class="grid3">
        {sections.map(([name, text], i) => (
          <li class="card">
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="your-ai">
    <div class="wrap">
      <div class="band">
        <div>
          <span class="eyebrow eyebrow--dark">Bring your own AI</span>
          <h2>Built for Your AI. Not Ours.</h2>
          <ol class="steps">{steps.map((s) => <li>{s}</li>)}</ol>
        </div>
        <ul class="never" aria-label="What LegalFriend does not receive">{never.map((n) => <li>{n}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section" id="notice">
    <div class="wrap">
      <div class="section-head">
        <h2>What this kit is and isn't</h2>
      </div>
      <RelationshipNotice />
      <p class="cta-note" style="text-align:center">Used LegalFriend's hosted Lease Review before? Existing analyses stay viewable until {LEASE_ACCESS_UNTIL}. <a href="/privacy#lease-review">What happens to your data</a>.</p>
    </div>
  </section>
</Base>
