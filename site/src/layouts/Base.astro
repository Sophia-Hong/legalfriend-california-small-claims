---
import "@fontsource/inter/300.css"
import "@fontsource/inter/400.css"
import "@fontsource/inter/500.css"
import "@fontsource/inter/600.css"
import "../styles/site.css"
import { SITE_LIVE, KIT_CHECKOUT_URL } from "../site"

interface Props {
  title: string
  description: string
  noindex?: boolean
}
const { title, description, noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, "").replace(/\/+$/, "") || "/", Astro.site)
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!SITE_LIVE || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LegalFriend" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    {!SITE_LIVE && (
      <div class="preview-banner"><div class="wrap">Preview build. Not yet published.</div></div>
    )}
    <nav class="nav" aria-label="Main">
      <div class="wrap">
        <a class="brand" href="/"><img src="/logo.svg" alt="" width="28" height="28" />LegalFriend</a>
        <div class="nav-links">
          <a href="/california-small-claims">Small Claims Kit</a>
          <a href="https://lease.legalfriend.ai">Lease Review</a>
        </div>
        {KIT_CHECKOUT_URL
          ? <a class="btn btn--nav" href={KIT_CHECKOUT_URL}>Get the kit</a>
          : <a class="btn btn--nav" href="/california-small-claims">Get the kit</a>}
      </div>
    </nav>
    <slot />
    <footer class="ref">
      <div class="wrap">
        <span>© {new Date().getFullYear()} PeopleShine Inc., dba LegalFriend</span>
        <span class="footer-links">
          <a href="/california-small-claims#notice">Before you buy</a>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy</a>
        </span>
      </div>
    </footer>
  </body>
</html>
